<Window x:Class="F1M24VoiceManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="F1M24 Voice Manager" Height="760" Width="1180" MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Fg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="6" Background="{StaticResource Accent}" CornerRadius="2" Margin="0,2,10,2"/>
            <StackPanel>
                <TextBlock Text="F1M24 Voice Manager" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Attribuez la voix radio d'un pilote ou d'un ingénieur à n'importe quel membre du staff."
                           Foreground="{StaticResource Muted}"/>
            </StackPanel>
        </StackPanel>

        <!-- Environment -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="F1 MANAGER 2024" Style="{StaticResource Caption}"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource Dot}" Fill="{Binding GameOk, Converter={StaticResource OkBrush}}"/>
                        <TextBlock Text="{Binding GameStatus}" FontWeight="SemiBold"/>
                        <Button Content="Choisir…" Click="ChooseGameFolder_Click" Style="{StaticResource LinkButton}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding GamePath}" Foreground="{StaticResource Muted}" FontSize="11"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding GamePath}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="UE4SS" Style="{StaticResource Caption}"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource Dot}" Fill="{Binding Ue4ssOk, Converter={StaticResource OkBrush}}"/>
                        <TextBlock Text="{Binding Ue4ssStatus}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="MOD DE VOIX" Style="{StaticResource Caption}"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource Dot}" Fill="{Binding ModOk, Converter={StaticResource OkBrush}}"/>
                        <TextBlock Text="{Binding ModStatus}" FontWeight="SemiBold"/>
                        <Button Content="Ouvrir" Command="{Binding OpenModFolderCommand}" Style="{StaticResource LinkButton}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Installé automatiquement au premier « Appliquer »." Foreground="{StaticResource Muted}" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Text="JEU" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding GameRunningStatus}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="4" Content="Actualiser" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Career + filters -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Carrière" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Saves}" SelectedItem="{Binding SelectedSave}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="  —  " Foreground="Gray"/>
                                <Run Text="{Binding LastWriteTime, Mode=OneWay, StringFormat='dd/MM/yyyy HH:mm'}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Content="Charger" Command="{Binding LoadSaveCommand}" Margin="8,0,12,0"/>
                <TextBlock Grid.Column="3" Text="{Binding CareerSummary}" VerticalAlignment="Center"
                           Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="4" Text="Afficher" VerticalAlignment="Center" Margin="12,0,8,0" FontWeight="SemiBold"/>
                <ComboBox Grid.Column="5" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Label"/>
                <TextBlock Grid.Column="6" Text="Rechercher" VerticalAlignment="Center" Margin="12,0,8,0" FontWeight="SemiBold"/>
                <TextBox Grid.Column="7" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Staff grid -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding RowsView}" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource Line}" BorderThickness="0" RowHeight="34"
                      Background="Transparent" RowBackground="Transparent" SelectionMode="Single"
                      SelectionUnit="FullRow" EnableRowVirtualization="True">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter Property="Background" Value="{StaticResource PendingBg}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Équipe" Binding="{Binding Team}" Width="170" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Poste" Binding="{Binding Position}" Width="190" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="190" IsReadOnly="True" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="ID" Binding="{Binding StaffId}" Width="55" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Voix enregistrée" Binding="{Binding RecordedVoice}" Width="110" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Voix utilisée" Width="*" MinWidth="240">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DonorOptions}"
                                          SelectedItem="{Binding SelectedDonor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="Label" Margin="4,3" IsTextSearchEnabled="True"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Actions + status -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Appliquer" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Annuler les modifications" Command="{Binding RevertCommand}" Margin="8,0,0,0"/>
                <Button Content="Tout remettre d'origine" Command="{Binding ResetAllCommand}" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Sauvegardes" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" DisplayMemberPath="Label" Width="260"/>
                <Button Content="Restaurer" Command="{Binding RestoreCommand}" Margin="8,0,0,0"/>
            </StackPanel>
            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="10,8" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource InfoBg}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Background" Value="{StaticResource ErrorBg}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</Window>
